{
  "name": "lithophane-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "build:preview": "vite build --mode pages-preview --outDir dist-preview",
    "preview:pages": "vite preview --mode pages-preview --outDir dist-preview --host 0.0.0.0 --port 4175",
    "check:preview": "node scripts/check-preview.mjs",
    "pages:create": "npx --yes wrangler@4.151.1 pages project create peggleg-lithophane --production-branch main",
    "pages:deploy:preview": "npm run build:preview && npm run check:preview && npx --yes wrangler@4.151.1 pages deploy dist-preview --project-name peggleg-lithophane --branch preview/lithophane",
    "check:resolution": "node scripts/validate-resolution.mjs",
    "test:browser": "node scripts/check-studio-browser.mjs",
    "test:clickers": "node scripts/check-clicker-browser.mjs",
    "test:fan": "node scripts/check-fan-crop-browser.mjs",
    "test:pebble-batch": "node scripts/check-pebble-batch-browser.mjs",
    "test:navigation": "node scripts/check-navigation-browser.mjs",
    "test:desk": "node scripts/check-desk-browser.mjs",
    "test:filament": "node scripts/check-filament-browser.mjs",
    "test:qr-drawers": "node scripts/check-qr-drawers-browser.mjs",
    "test:desk-details": "node scripts/check-desk-details-browser.mjs",
    "test:standalone-trays": "node scripts/check-standalone-trays-browser.mjs",
    "test:bambu-import": "node scripts/check-bambu-import.mjs",
    "test:openwork": "node scripts/check-openwork-browser.mjs",
    "test:desk-fit": "node scripts/check-desk-fit-browser.mjs",
    "test:screw-containers": "node scripts/check-desk-screw-browser.mjs",
    "test:compartment-storage": "node scripts/check-desk-storage-browser.mjs",
    "test:coasters": "node scripts/check-desk-coasters-browser.mjs",
    "test:lantern": "node scripts/check-lantern-browser.mjs",
    "test:lantern-lifecycle": "node scripts/check-lantern-lifecycle-browser.mjs",
    "test:coaster-plant": "node scripts/check-coaster-plant-browser.mjs",
    "test:drawer-sheets": "node scripts/check-drawer-sheets-browser.mjs",
    "test:home": "node scripts/check-home-browser.mjs",
    "test:cupboards": "node scripts/check-cupboard-browser.mjs",
    "test:homepage": "node scripts/check-homepage-browser.mjs",
    "test:storage-options": "node scripts/check-storage-options-browser.mjs",
    "test:storage-options-slicer": "node scripts/check-storage-options-slicer.mjs",
    "test:pill-box": "node scripts/check-pill-box-browser.mjs",
    "test:printers": "node scripts/check-printer-browser.mjs",
    "test:printer-import": "node scripts/check-printer-import.mjs",
    "test:printer-slices": "node scripts/check-printer-slices.mjs",
    "test:coaster-veins": "node scripts/check-coaster-veins-browser.mjs",
    "test:coaster-veins-slicer": "node scripts/check-coaster-veins-slicer.mjs",
    "test:products": "node scripts/check-product-browser.mjs",
    "test:product-slicer": "node scripts/check-product-slicer.mjs",
    "test:pegboards": "node scripts/check-pegboard-layout-browser.mjs",
    "test:studio-layout": "node scripts/check-studio-layout-browser.mjs",
    "test:games": "node --test --test-concurrency=1 test/game-boards.test.js test/game-seasonal-pegs.test.js test/game-products.test.js test/game-shuffler.test.js test/print-profile.test.js test/product-plates.test.js test/game-compact-storage.test.js test/game-slim-release.test.js test/game-piece-exports.test.js test/game-dots-grooves.test.js",
    "test:games-browser": "node scripts/check-game-boards-browser.mjs",
    "test:games-native": "node scripts/check-games-native.mjs",
    "test:compact-games-browser": "node scripts/check-compact-games-browser.mjs",
    "test:slim-games-browser": "node scripts/check-slim-games-browser.mjs",
    "test:game-pieces-browser": "node scripts/check-game-piece-exports.mjs",
    "test:ornaments": "node scripts/check-ornaments-browser.mjs",
    "test:ornament-slicer": "node scripts/check-ornament-slicer.mjs"
  },
  "devDependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "vite": "8.3.4"
  },
  "dependencies": {
    "manifold-3d": "3.5.4",
    "opentype.js": "2.0.0",
    "qrcode": "^1.5.4",
    "three": "0.186.1"
  }
}
